{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VistaVerge",
  "version": "0.1.0-beta.2",
  "identifier": "com.vistaverge.app",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VistaVerge",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: ipc: http://ipc.localhost; connect-src 'self' https: wss: blob: data: http://localhost:* ws://localhost:* ipc: http://ipc.localhost http://vvmodel.localhost; img-src 'self' data: blob: http://vvmodel.localhost; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' http://vvmodel.localhost; worker-src 'self' blob:; child-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installer/installer-hooks.nsh",
        "customLanguageFiles": {
          "SimpChinese": "installer/SimpChinese.nsh"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDMTA4RjRFRUExM0ZBQgpSV1NyUDZIdTlBakJDL3paeUdublJuZmFhZTRqb3hoV2RGbGZlaE4vVzFSRVlPRjZncUpHQ0M2cQo=",
      "endpoints": [
        "https://github.com/zouyuxuan122/VistaVerge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
