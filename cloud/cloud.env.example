# ☁ 全云端模式配置 —— 复制为 cloud.env 后填写
# 也可直接在前端「设置 → ☁ 云服务」填好后点「下载 cloud.env」

# —— 耳朵 · STT（OpenAI 兼容 /v1/audio/transcriptions）——
S2S_STT_BASE_URL=https://api.siliconflow.cn/v1
S2S_STT_MODEL=FunAudioLLM/SenseVoiceSmall
S2S_STT_API_KEY=

# —— 大脑 · LLM（OpenAI 兼容 /v1/chat/completions）——
S2S_LLM_BASE_URL=https://api.siliconflow.cn/v1
S2S_LLM_MODEL=Qwen/Qwen3-14B
S2S_LLM_API_KEY=

# —— 嘴巴 · TTS（OpenAI 兼容 /v1/audio/speech）——
# 克隆音色：先到供应商控制台上传 ref.wav 建自定义音色，把音色 ID 填到 S2S_TTS_VOICE
# 硅基流动克隆音色 ID 形如 <user>:<voice_id>；不填则用供应商默认音色
S2S_TTS_BASE_URL=https://api.siliconflow.cn/v1
S2S_TTS_MODEL=Fish-speech/fish-speech-1.5
S2S_TTS_API_KEY=
S2S_TTS_VOICE=

# —— 可选手感（与原 start-voice.sh 同义）——
S2S_LANGUAGE=zh
S2S_VAD_THRESH=0.6
S2S_MIN_SPEECH_MS=500
S2S_MIN_SILENCE_MS=1200
S2S_SPEECH_PAD_MS=300
